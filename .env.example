# Copy to .env.local. `pnpm bootstrap` writes this file for you from the local Supabase stack.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS: never prefix with NEXT_PUBLIC_, never import outside src/lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=

# Server-only. Authenticates the scheduler's call to /api/tick and can do nothing else.
# At least 32 characters. `pnpm bootstrap` generates one; production gets its own.
TICK_SECRET=

# The site's own origin, for links in emails.
APP_URL=http://localhost:3000

# Email. Without RESEND_API_KEY, email goes over SMTP to the local mail catcher
# (http://127.0.0.1:54324). Production sets the key and a sender on the verified domain.
# RESEND_API_KEY=
# EMAIL_FROM="Heads-up <alerts@your-domain.example>"
# SMTP_HOST=127.0.0.1
# SMTP_PORT=54325

# "true" only in production: lets the tick call the real sources.
# REAL_POLLING=false

# Increment 2.
# GUARDIAN_API_KEY=
# COINGECKO_API_KEY=
