# Copy to .env.local. `pnpm bootstrap` writes this file for you from the local Supabase stack.

# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Bypasses RLS: never prefix with NEXT_PUBLIC_, never import outside src/lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=
