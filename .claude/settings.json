{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install*)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm verify*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm e2e*)",
      "Bash(pnpm build*)",
      "Bash(pnpm dev*)",
      "Bash(pnpm format*)",
      "Bash(pnpm bootstrap*)",
      "Bash(pnpm db:start*)",
      "Bash(pnpm db:stop*)",
      "Bash(pnpm db:status*)",
      "Bash(pnpm db:reset*)",
      "Bash(pnpm db:new *)",
      "Bash(pnpm db:types*)",
      "Bash(pnpm db:test*)",
      "Bash(pnpm exec prettier *)",
      "Bash(pnpm exec eslint *)",
      "Bash(pnpm exec vitest *)",
      "Bash(pnpm exec playwright *)",
      "Bash(pnpm exec next *)",
      "Bash(pnpm exec tsc *)",
      "Bash(pnpm exec supabase status*)",
      "Bash(pnpm exec supabase migration new *)",
      "Bash(pnpm exec supabase migration list*)",
      "Bash(pnpm dlx shadcn@latest add *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(git worktree *)",
      "Bash(git fetch*)",
      "Bash(git stash*)",
      "Bash(gh issue *)",
      "Bash(gh label *)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh pr create *)",
      "Bash(gh pr ready*)",
      "Bash(gh run *)",
      "Bash(gh api repos/*)",
      "Bash(gh api --method POST repos/*)",
      "mcp__next-devtools",
      "mcp__shadcn",
      "mcp__playwright",
      "mcp__context7"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(.env.*.local)",
      "Edit(.env)",
      "Edit(.env.local)",
      "Edit(.env.production)",
      "Edit(.env.*.local)",
      "Edit(/src/lib/supabase/database.types.ts)",
      "Edit(/pnpm-lock.yaml)",
      "Bash(pnpm exec supabase db reset --linked*)",
      "Bash(pnpm exec supabase db reset --remote*)",
      "Bash(pnpm db:reset --linked*)",
      "Bash(pnpm db:reset --remote*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Bash(pnpm exec supabase link*)",
      "Bash(pnpm exec supabase db push*)",
      "Bash(vercel *)",
      "Bash(pnpm dlx vercel *)",
      "Bash(pnpm dlx vercel@latest *)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledMcpjsonServers": [
    "next-devtools",
    "shadcn",
    "playwright",
    "context7"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit.mjs\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.mjs\"",
            "timeout": 300
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-verify.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  }
}
